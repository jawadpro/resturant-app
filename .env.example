APP_NAME="MFD Books"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL from Hostinger hPanel (Databases). From the website itself the host is 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# File sessions work before the database exists (needed for the /install page).
# 12 hours, so a long shift doesn't get signed out mid-close.
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- MFD Books ---
# Names shown in the app ("Send to <manager>", "Paid by <owner>").
BOOKS_BUSINESS_NAME="My Restaurant"
BOOKS_OWNER_NAME=Owner
BOOKS_MANAGER_NAME=Manager
BOOKS_TIMEZONE=Asia/Bangkok
# Before this hour, entries still count as the previous night.
BOOKS_CUTOFF_HOUR=6
BOOKS_COMMISSION_RATE=0.375
BOOKS_DRINK_PRICE=160

# One-time setup page at /install. Use a long random value (20+ characters).
# Remove it (leave empty) once setup is done to switch the page off.
INSTALL_TOKEN=
