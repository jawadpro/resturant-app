# For shared hosting where the whole project sits in public_html:
# send every request into Laravel's public/ folder, so .env, storage and code are never reachable.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
